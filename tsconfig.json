{
    "extends": "./node_modules/@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "strict": false,
        "verbatimModuleSyntax": false,
        "isolatedModules": true,
        "allowJs": true,
        "noEmit": true,
        "rootDir": ".",
        "paths": {
            "~src/*": ["./src/*"],
            "~test/*": ["./test/*"],
            "~resources/*": ["./resources/*"]
        },
        "types": ["node", "jest"]
    },
    "include": ["./src/**/*", "./test/**/*", "./scripts/**/*", "./*.ts", "./*.js", "./launcher/*.ts", "./*.mjs"]
}
